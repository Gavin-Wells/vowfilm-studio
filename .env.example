STARNET_BASE_URL=https://open.embervale.cn
STARNET_API_KEY=
STARNET_LLM_MODEL=openai/gpt-6-astra
STARNET_VIDEO_MODEL=starnet/minimax-h3
STARNET_AUDIO_MODEL=volcengine/doubao-seed-audio-1-0
# Optional OpenAI-compatible aliases (used when STARNET_* is unset):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
GO_BACKEND_URL=http://127.0.0.1:8097
GO_BACKEND_TOKEN=replace-with-at-least-32-random-characters
VOWFILM_ADDR=127.0.0.1:8097
VOWFILM_CONCURRENCY=2
PUBLIC_MEDIA_BASE_URL=
# Account/project/billing database: sqlite (default) or postgres.
DATABASE_DRIVER=sqlite
# SQLite: optional absolute file path; PostgreSQL: connection URL with sslmode.
DATABASE_URL=
# Optional fixed bootstrap secret. If unset, read data/admin-setup.txt after startup.
VOWFILM_SETUP_TOKEN=
